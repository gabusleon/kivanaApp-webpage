---
import PlantillaBase from '@plantillas/PlantillaBase.astro';
import Boton from '@componentes/comunes/Boton.astro';
import BannerCTA from '@componentes/comunes/BannerCTA.astro';
import { Image } from 'astro:assets';

// Icono para CTA
import iconoOrganizar from '@assets/images/Iconos/organizar.webp';

// Importación de Assets
import heroMockup from '@assets/images/Home/Home-hero2.webp';
import problemaImg from '@assets/images/Home/Home-problema.webp';
import solucionImg from '@assets/images/Home/Home-soluciom.webp';
import organizarcioImg from '@assets/images/Home/Home-kidos.webp';
import recuerdosImg from '@assets/images/Nosotros/familia.webp';
import actividadCompleta from '@assets/images/Home/Home-actividad-completa.webp';
import actividadVerificaion from '@assets/images/Home/Home-actividad-verificacion.webp';
import actividadRecompensa from '@assets/images/Home/Home-actividad-recompensa.webp';
import acompanamientoImg from '@assets/images/Home/Home-dino-amarillo.webp';
import mockupAplicacion from '@assets/images/Home/tareas.webp';

// Capturas de pantalla para "Un vistazo a Kivana"
import tareas1Img from '@assets/images/Home/tareas1.webp';
import tareas2Img from '@assets/images/Home/tareas2.webp';
import tareas3Img from '@assets/images/Home/tareas3.webp';
---

<PlantillaBase 
  titulo="Inicio - La vida familiar, más organizada y divertida"
  descripcion="Kivana es la aplicación familiar para organizar eventos, tareas, miembros y recuerdos en un solo lugar, con una experiencia de hábitos y recompensas para niños mediante Kidos."
  rutaActual="/"
>
  <!-- 1. HERO SECTION -->
  <section class="hero seccion">
    <div class="contenedor hero__contenedor">
      <div class="hero__contenido">
        <h1 class="hero__titulo">La vida familiar, más organizada y divertida.</h1>
        <p class="hero__descripcion">
          Cada tarea, cada plan y cada pequeño logro pueden convertirse en una experiencia para toda la familia.
        </p>
        <div class="hero__acciones">
          <Boton href='/funcionalidades' variante="kidos">
            Conoce Kivana
          </Boton>
        </div>
      </div>
      <div class="hero__visual">
        <Image 
          src={heroMockup} 
          alt="Vista previa de Kivana en smartphone con dinosaurios felices" 
          class="hero__imagen"
          width={540}
          height={540}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- 2. PROBLEMA COTIDIANO -->
  <section class="seccion seccion--amarillo">
    <div class="contenedor grid-dos-columnas grid-dos-columnas--reverso">
      <div class="bloque-texto">
        <h2 class="seccion__titulo">En casa, todos tienen algo que hacer.</h2>
        <p class="bloque-texto__descripcion">
          La vida familiar tiene muchas cosas pasando al mismo tiempo. Kivana pone orden al día a día.
        </p>
      </div>
      <div class="bloque-visual">
        <Image 
          src={problemaImg} 
          alt="Ilustración de la vida familiar con múltiples actividades simultáneas" 
          class="bloque-visual__imagen"
          width={480}
          height={480}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- 3. ORGANIZACIÓN FAMILIAR -->
  <section class="seccion seccion--blanca">
    <div class="contenedor grid-dos-columnas">
      <div class="bloque-texto">
        <h2 class="bloque-texto__titulo resaltar-menta"> <span class="resaltar-azul">Kivana</span> pone orden al día a día.</h2>
        <p class="bloque-texto__descripcion">
          Kivana ayuda a que cada miembro de la familia sepa qué toca hoy y qué viene después.
        </p>
        <ul class="lista-beneficios">
          <li class="lista-beneficios__item">✓ Calendario familiar</li>
          <li class="lista-beneficios__item">✓ Tareas compartidas</li>
          <li class="lista-beneficios__item">✓ Familia privada</li>
        </ul>
      </div>
      <div class="bloque-visual">
        <Image 
          src={solucionImg} 
          alt="Pantalla de organización diaria en Kivana" 
          class="bloque-visual__imagen"
          width={480}
          height={480}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- 4. KIDOS AVENTURA -->
  <section class="seccion seccion--amarillo">
    <div class="contenedor texto-centrado grid-dos-columnas">
      <div class="kidos-flujo-contenedor">
        <Image 
          src={organizarcioImg} 
          alt="Flujo Kidos: Actividad completada -> Validación del padre -> Puntos y recompensas" 
          class="kidos-flujo-imagen"
          width={1000}
          height={400}
          loading="lazy"
        />
      </div>
      <div>
        <h2 class="seccion__titulo">Organizarse también puede ser una aventura.</h2>
        <p class="seccion__subtitulo">
          Con Kidos, las actividades cotidianas se convierten en progreso, huevos y recompensas que motivan a los niños mientras los padres acompañan cada paso.
        </p>
        <div class="espacio-superior-lg">
          <Boton href='/kidos' variante="primario">
            Descubre cómo funciona Kidos
          </Boton>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FUNCIONAMIENTO KIDOS -->
  <section class="seccion seccion--amarillo">
    <div class="contenedor texto-centrado">
      <div class="pasos-grid">
        <article class="pasos-card">
          <Image src={actividadCompleta} alt="Actividad Completada" class="pasos-card__imagen" width={320} height={320} loading="lazy" />
          <h3 class="pasos-card__titulo">Actividad Completada</h3>
        </article>
        <article class="pasos-card">
          <Image src={actividadVerificaion} alt="Validación del padre" class="pasos-card__imagen" width={320} height={320} loading="lazy" />
          <h3 class="pasos-card__titulo">Validacion del padre.</h3>
        </article>
        <article class="pasos-card">
          <Image src={actividadRecompensa} alt="Puntos y recompensas" class="pasos-card__imagen" width={320} height={320} loading="lazy" />
          <h3 class="pasos-card__titulo">Puntos y recompensas.</h3>
        </article>
      </div>
    </div>
  </section>

  <!-- 6. ACOMPAÑAMIENTO PARENTAL -->
  <section class="seccion">
    <div class="contenedor tres-columnas">
      <div class="bloque-visual">
        <Image 
          src={mockupAplicacion} 
          alt="Mockup de aplicación Kivana." 
          class="bloque-visual__imagen"
          width={480}
          height={480}
          loading="lazy"
        />
      </div>
      <div class="bloque-texto centrar-vertical">
        <h2 class="bloque-texto__titulo">Ellos participan. <br><span class="resaltar-coral"> Tú acompañas. </span></h2>
        <p class="bloque-texto__descripcion">
          Los niños avanzan en sus actividades y los padres validan sus logros antes de continuar su aventura.
        </p>
      </div>
      <div class="bloque-visual alinear-abajo">
        <Image 
          src={acompanamientoImg} 
          alt="Participación y recompensa." 
          class="bloque-visual__imagen"
          width={480}
          height={480}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- 7. RECUERDOS -->
  <section class="seccion seccion--blanca">
    <div class="contenedor grid-dos-columnas">
      <div class="bloque-texto">
        <h2 class="bloque-texto__titulo">Hay momentos que merecen quedarse.</h2>
        <p class="bloque-texto__descripcion">
          Kivana no solo ayuda a organizar lo que viene. También permite guardar lo que ya vivieron juntos con fotos, comentarios y galería familiar.
        </p>
      </div>
      <div class="bloque-visual">
        <Image 
          src={recuerdosImg} 
          alt="Familia de dinosaurios compartiendo un álbum de recuerdos" 
          class="bloque-visual__imagen"
          width={480}
          height={480}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- 8. UN VISTAZO A KIVANA  -->
  <section class="seccion seccion-vistazo">
    <div class="contenedor texto-centrado">
      <h2 class="seccion__titulo">Un vistazo a Kivana</h2>
      <p class="seccion__subtitulo">Una interfaz limpia, cálida y pensada para la vida diaria del hogar.</p>
      
      <div class="vistazo-grid">
        <div class="vistazo-pantalla vistazo-pantalla--izquierda">
          <Image 
            src={tareas1Img} 
            alt="Pantalla de Tareas completadas en Kivana" 
            class="vistazo-imagen"
            width={340}
            height={580}
            loading="lazy"
          />
        </div>
        <div class="vistazo-pantalla vistazo-pantalla--centro">
          <Image 
            src={tareas2Img} 
            alt="Pantalla principal de Tareas en Kivana" 
            class="vistazo-imagen"
            width={360}
            height={620}
            loading="lazy"
          />
        </div>
        <div class="vistazo-pantalla vistazo-pantalla--derecha">
          <Image 
            src={tareas3Img} 
            alt="Pantalla de Calendario en Kivana" 
            class="vistazo-imagen"
            width={340}
            height={580}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 9. CTA FINAL -->
  <BannerCTA
    colorFondo="var(--color-amarillo)"
    imagen={iconoOrganizar}
    altImagen="Icono de organización"
    titulo="Organiza lo que importa."
    descripcion="Conecta a tu familia con una experiencia simple y organizada."
    textoBoton1="Conoce Kivana"
    hrefBoton1="/funcionalidades"
    textoBoton2="Ver funcionalidades"
    hrefBoton2="/funcionalidades"
  />
</PlantillaBase>

<style>
  .hero {
    padding-top: var(--espacio-lg);
    padding-bottom: var(--espacio-xl);
  }

  .hero__contenedor {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero__contenedor {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .hero__titulo {
    font-family: var(--fuente-titulos);
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    font-weight: 500;
    color: var(--color-menta);
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }

  .hero__descripcion {
    font-size: 1.2rem;
    margin-bottom: 2rem;
    max-width: 560px;
    color: #123B56;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .hero__imagen {
    width: 100%;
    max-width: 520px;
    height: auto;
    margin-left: auto;
    margin-right: auto;
  }

  @media(max-width: 1024px){
    .hero__descripcion{
      text-align: center;
    }
    .hero__titulo{
      text-align: center;
    }
    .hero__acciones{
      justify-content: center;
    }
  }

  /* Diseños de Grid */
  .grid-dos-columnas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .grid-dos-columnas {
      grid-template-columns: 1fr 1fr;
    }

    .grid-dos-columnas--reverso {
      grid-template-columns: 1fr 1fr;
    }

    .grid-dos-columnas--reverso .bloque-texto {
      order: 2;
    }

    .grid-dos-columnas--reverso .bloque-visual {
      order: 1;
    }
  }

  .bloque-texto__titulo {
    font-family: var(--fuente-titulos);
    font-size: clamp(1.85rem, 3.2vw, 2.5rem);
    font-weight: 500;
    color: #123B56;
    line-height: 1.25;
    margin-bottom: 1rem;
    text-wrap: balance;
  }

  .bloque-texto__descripcion {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
    color: #123B56;
  }

  .bloque-visual__imagen {
    width: 100%;
    max-width: 460px;
    height: auto;
    margin-left: auto;
    margin-right: auto;
  }

  @media(max-width: 1024px) {
    .bloque-texto{
      text-align: center;
    }
  }

  .seccion--crema-oscura {
    background-color: rgba(var(--color-amarillo-rgb), 0.12);
  }

  .seccion--blanca {
    background-color: var(--color-blanco);
  }

  .seccion--amarillo{
    background-color: var(--color-amarillo);
  }

  .seccion__titulo {
    font-family: var(--fuente-titulos);
    font-size: clamp(2.1rem, 3.8vw, 2.8rem);
    font-weight: 500;
    color: var(--color-azul);
    margin-bottom: 1rem;
  }

  .seccion__subtitulo {
    font-family: var(--fuente-cuerpo);
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 2.5rem;
    font-size: 1.1rem;
    color: #123B56;
    opacity: 0.85;
  }

  /* Lista de Beneficios */
  .lista-beneficios {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .lista-beneficios__item {
    font-family: var(--fuente-cuerpo);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-menta);
  }

  /* Kidos Flujo */
  .kidos-flujo-imagen {
    width: 100%;
    max-width: 960px;
    height: auto;
    margin-left: auto;
    margin-right: auto;
  }

  .espacio-superior-lg {
    margin-top: 2rem;
  }

  /* Pasos Kivana */
  .pasos-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .pasos-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pasos-card:hover {
    transform: translateY(-4px);
  }

  .pasos-card__imagen {
    width: 100%;
    height: auto;
    border-radius: var(--radio-sm);
    margin-bottom: 1rem;
    display: block;
  }

  @media (max-width: 767px) {
    .pasos-card__imagen {
      width: 90%;
      max-width: 280px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  .pasos-card__titulo {
    font-family: var(--fuente-titulos);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-azul);
    padding: 0.85rem 0.85rem;
    background-color: var(--color-crema);
    border-radius: var(--radio-md);
  }

  .tres-columnas{
    display: flex;
  }
  @media (max-width: 1024px) {
    .tres-columnas{
      flex-direction: column;
      gap: 30;
    }
  }
  /* 10. UN VISTAZO A KIVANA */
  .seccion-vistazo {
    background-color: var(--color-crema);
    padding-top: 4.5rem;
    padding-bottom: 5.5rem;
  }

  .vistazo-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .vistazo-grid {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 0;
      max-width: 980px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  .vistazo-pantalla {
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(18, 59, 86, 0.12);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    width: 100%;
    max-width: 310px;
    position: relative;
  }

  @media (max-width: 767px) {
    .vistazo-pantalla {
      max-width: 260px;
      width: 85%;
    }
  }

  @media (min-width: 768px) {
    .vistazo-pantalla {
      flex: 1;
    }

    .vistazo-pantalla--izquierda {
      z-index: 1;
      transform: scale(0.7);
      margin-right: -4%;
    }
    .vistazo-pantalla--izquierda:hover {
      transform: scale(0.8);
      box-shadow: 0 28px 60px rgba(18, 59, 86, 0.28);
    }
    .vistazo-pantalla--centro {
      z-index: 3;
      transform: scale(0.8);
      box-shadow: 0 24px 50px rgba(18, 59, 86, 0.22);
    }

    .vistazo-pantalla--centro:hover {
      transform: scale(0.9);
      box-shadow: 0 28px 60px rgba(18, 59, 86, 0.28);
    }
    .vistazo-pantalla--derecha:hover {
      transform: scale(0.8);
      box-shadow: 0 28px 60px rgba(18, 59, 86, 0.28);
    }

    .vistazo-pantalla--derecha {
      z-index: 1;
      transform: scale(0.7);
      margin-left: -4%;
    }
  }

  .vistazo-imagen {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: 28px;
  }

  /* CTA Final */
  .cta-final {
    background-color: #FFD27A;
    color: #123B56;
    text-align: center;
    border-radius: var(--radio-lg);
    margin: 3rem 1.5rem;
  }

  .cta-final__titulo {
    font-family: var(--fuente-titulos);
    font-size: 2.2rem;
    font-weight: 500;
    color: #123B56;
    margin-bottom: 1rem;
  }

  .cta-final__descripcion {
    color: #123B56;
    font-size: 1.2rem;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 2rem;
  }

  .cta-final__acciones {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .centrar-vertical{
    display: flex;
    flex-direction: column;
    text-align: center;
    justify-content: center;
  }

  .alinear-abajo {
    display: flex;
    flex-direction: column-reverse;
  }

  .resaltar-coral{
    color: var(--color-coral);
  }

  .resaltar-azul{
    color: var(--color-azul);
  }
  .resaltar-menta{
    color: var(--color-menta);
  }
</style>
