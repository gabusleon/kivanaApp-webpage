---
import PlantillaBase from '@plantillas/PlantillaBase.astro';
import Boton from '@componentes/comunes/Boton.astro';
import BannerCTA from '@componentes/comunes/BannerCTA.astro';
import { Image } from 'astro:assets';

// Imágenes de Nosotros
import nosotrosHeroImg from '@assets/images/Nosotros/Hero.webp';
import organizacionSimpleImg from '@assets/images/Nosotros/familia.webp';

// Iconos para las 3 tarjetas inclinadas
import iconoOrganizar from '@assets/images/Iconos/organizar.webp';
import iconoParticipar from '@assets/images/Iconos/participar.webp';
import iconoRecordar from '@assets/images/Iconos/recuerdos.webp';

// Iconos para la sección de Nuestros Valores
import iconoCercania from '@assets/images/Iconos/cercania.webp';
import iconoColaboracion from '@assets/images/Iconos/colaboracion.webp';
import iconoAcompanamiento from '@assets/images/Iconos/acompanamiento.webp';
import iconoMemoria from '@assets/images/Iconos/memoria.webp';
---

<PlantillaBase 
  titulo="Nosotros - Historia y Propósito"
  descripcion="Conoce la historia, visión y valores de Kivana: crear una forma más simple de vivir la organización familiar."
  rutaActual="/nosotros"
>
  <!-- 1. HERO NOSOTROS -->
  <section class="seccion hero-nosotros">
    <div class="contenedor grid-dos-columnas">
      <div class="bloque-texto">
        <h1 class="hero__titulo">Una forma más simple de vivir la organización familiar</h1>
        <p class="hero__descripcion">
          Kivana nace para ayudar a las familias a coordinarse, motivar a los niños y conservar los momentos que importan en la vida cotidiana.
        </p>
        <div class="hero__acciones">
          <Boton href='/funcionalidades' variante="primario">
            Conoce Kivana
          </Boton>
        </div>
      </div>
      <div class="bloque-visual">
        <Image 
          src={nosotrosHeroImg} 
          alt="Ilustración de la familia Kivana" 
          class="bloque-visual__imagen"
          width={480}
          height={480}
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- 2. ¿Y SI TODO VIVIERA EN UN SOLO LUGAR? (IMAGEN 1 - FONDO VERDE MENTA) -->
  <section class="seccion seccion-solo-lugar">
    <div class="contenedor grid-dos-columnas">
      <div class="bloque-visual">
        <Image 
          src={organizacionSimpleImg} 
          alt="Dinosaurios reunidos alrededor de la mesa con fotos y elementos flotantes" 
          class="bloque-visual__imagen"
          width={480}
          height={480}
          loading="lazy"
        />
      </div>
      <div class="bloque-texto">
        <h2 class="solo-lugar__titulo">¿Y si todo viviera en un solo lugar?</h2>
        <p class="solo-lugar__descripcion">
          Kivana nace de una idea sencilla: reunir lo importante en un solo lugar y hacer que cada miembro pueda participar.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. QUEREMOS QUE ORGANIZAR LA FAMILIA... + 3 TARJETAS INCLINADAS (IMAGEN 2) -->
  <section class="seccion seccion-tarjetas-inclinadas">
    <div class="contenedor texto-centrado">
      <p class="tarjetas-inclinadas__descripcion">
        Queremos que organizar la familia no sea solamente administrar pendientes. También significa construir hábitos, acompañar a los niños y guardar las experiencias que hacen especial la vida cotidiana.
      </p>

      <div class="tarjetas-inclinadas__grid">
        <!-- TARJETA ORGANIZAR -->
        <article class="tarjeta-inclinada tarjeta-inclinada--organizar">
          <div class="tarjeta-inclinada__icono-wrapper">
            <Image src={iconoOrganizar} alt="Icono de Organizar" class="tarjeta-inclinada__icono" width={140} height={140} loading="lazy" />
          </div>
          <h3 class="tarjeta-inclinada__titulo">Organiza</h3>
        </article>

        <!-- TARJETA PARTICIPAR -->
        <article class="tarjeta-inclinada tarjeta-inclinada--participar">
          <div class="tarjeta-inclinada__icono-wrapper">
            <Image src={iconoParticipar} alt="Icono de Participar" class="tarjeta-inclinada__icono" width={140} height={140} loading="lazy" />
          </div>
          <h3 class="tarjeta-inclinada__titulo">Participa</h3>
        </article>

        <!-- TARJETA RECORDAR -->
        <article class="tarjeta-inclinada tarjeta-inclinada--recordar">
          <div class="tarjeta-inclinada__icono-wrapper">
            <Image src={iconoRecordar} alt="Icono de Recordar" class="tarjeta-inclinada__icono" width={140} height={140} loading="lazy" />
          </div>
          <h3 class="tarjeta-inclinada__titulo">Recuerda</h3>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. NUESTROS VALORES (IMAGEN 3) -->
  <section class="seccion seccion-valores">
    <div class="contenedor texto-centrado">
      <h2 class="valores__titulo-principal">Nuestros valores</h2>
      
      <div class="valores__layout">
        <!-- FILA 1: Cercanía y Colaboración -->
        <div class="valores__fila">
          <p class="valores__texto-lateral valores__texto-lateral--izquierda">
            Una herramienta para<br />la vida cotidiana
          </p>

          <article class="valores__tarjeta valores__tarjeta--cercania">
            <Image src={iconoCercania} alt="Cercanía" class="valores__icono" width={90} height={90} loading="lazy" />
            <h3 class="valores__tarjeta-titulo color-menta">Cercanía</h3>
          </article>

          <article class="valores__tarjeta valores__tarjeta--colaboracion">
            <Image src={iconoColaboracion} alt="Colaboración" class="valores__icono" width={90} height={90} loading="lazy" />
            <h3 class="valores__tarjeta-titulo color-amarillo">Colaboración</h3>
          </article>

          <p class="valores__texto-lateral valores__texto-lateral--derecha">
            Cada integrante puede<br />participar.
          </p>
        </div>

        <!-- FILA 2: Acompañamiento y Memoria -->
        <div class="valores__fila">
          <p class="valores__texto-lateral valores__texto-lateral--izquierda">
            Motivar sin prometer<br />control.
          </p>

          <article class="valores__tarjeta valores__tarjeta--acompanamiento">
            <Image src={iconoAcompanamiento} alt="Acompañamiento" class="valores__icono" width={90} height={90} loading="lazy" />
            <h3 class="valores__tarjeta-titulo color-coral">Acompañamiento</h3>
          </article>

          <article class="valores__tarjeta valores__tarjeta--memoria">
            <Image src={iconoMemoria} alt="Memoria" class="valores__icono" width={90} height={90} loading="lazy" />
            <h3 class="valores__tarjeta-titulo color-azul">Memoria</h3>
          </article>

          <p class="valores__texto-lateral valores__texto-lateral--derecha">
            Organizar lo que viene<br />y conservar lo vivido.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <BannerCTA
    colorFondo="var(--color-coral)"
    colorTexto="blanco"
    imagen={iconoColaboracion}
    altImagen="Icono de colaboración en equipo"
    titulo="Construyamos juntos la organización familiar."
    descripcion="Únete a las familias que ya organizan lo que importa de manera cercana y colaborativa."
    textoBoton1="Conoce Kivana"
    hrefBoton1="/funcionalidades"
    textoBoton2="Contáctanos"
    hrefBoton2="/contacto"
  />
</PlantillaBase>

<style>
  /* HERO NOSOTROS */
  .hero-nosotros {
    background-color: var(--color-crema);
    padding-top: 3.5rem;
    padding-bottom: 4.5rem;
  }

  .grid-dos-columnas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .grid-dos-columnas {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero__titulo {
    font-family: var(--fuente-titulos);
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    font-weight: 500;
    color: var(--color-menta);
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }

  .hero__descripcion {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #123B56;
    opacity: 0.85;
    margin-bottom: 2rem;
  }

  .bloque-visual__imagen {
    width: 100%;
    max-width: 460px;
    height: auto;
    margin-left: auto;
    margin-right: auto;
    object-fit: contain;
  }

  /* SECCIÓN ¿Y SI TODO VIVIERA EN UN SOLO LUGAR? (VERDE MENTA) */
  .seccion-solo-lugar {
    background-color: var(--color-menta);
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
    color: var(--color-blanco);
  }

  .solo-lugar__titulo {
    font-family: var(--fuente-titulos);
    font-size: clamp(2.1rem, 3.8vw, 2.8rem);
    font-weight: 500;
    color: var(--color-amarillo);
    line-height: 1.25;
    margin-bottom: 1.25rem;
  }

  .solo-lugar__descripcion {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--color-blanco);
    max-width: 520px;
    margin: 0;
  }

  /* SECCIÓN TARJETAS INCLINADAS (ORGANIZAR, PARTICIPAR, RECORDAR) */
  .seccion-tarjetas-inclinadas {
    background-color: var(--color-crema);
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .tarjetas-inclinadas__descripcion {
    font-size: 1.15rem;
    line-height: 1.65;
    color: #123B56;
    opacity: 0.85;
    max-width: 660px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 3.5rem;
  }

  .tarjetas-inclinadas__grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .tarjetas-inclinadas__grid {
      flex-direction: row;
      gap: 2.5rem;
    }
  }

  .tarjeta-inclinada {
    width: 220px;
    height: 250px;
    border-radius: 28px;
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    box-shadow: 0 16px 36px rgba(18, 59, 86, 0.12);
    transition: transform 0.3s ease;
  }

  .tarjeta-inclinada:hover {
    transform: scale(1.05) rotate(0deg) !important;
  }

  .tarjeta-inclinada--organizar {
    background-color: var(--color-menta);
    transform: rotate(-7deg);
  }

  .tarjeta-inclinada--participar {
    background-color: var(--color-coral);
    transform: rotate(2deg);
  }

  .tarjeta-inclinada--recordar {
    background-color: var(--color-amarillo);
    transform: rotate(7deg);
  }

  .tarjeta-inclinada__icono-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tarjeta-inclinada__icono {
    width: 120px;
    height: auto;
    object-fit: contain;
  }

  .tarjeta-inclinada__titulo {
    font-family: var(--fuente-titulos);
    font-size: 1.4rem;
    font-weight: 500;
    margin: 0;
  }

  .tarjeta-inclinada--organizar .tarjeta-inclinada__titulo,
  .tarjeta-inclinada--participar .tarjeta-inclinada__titulo {
    color: var(--color-blanco);
  }

  .tarjeta-inclinada--recordar .tarjeta-inclinada__titulo {
    color: #123B56;
  }

  /* SECCIÓN NUESTROS VALORES */
  .seccion-valores {
    background-color: var(--color-crema);
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .valores__titulo-principal {
    font-family: var(--fuente-titulos);
    font-size: clamp(2.2rem, 3.8vw, 2.8rem);
    font-weight: 500;
    color: #123B56;
    margin-bottom: 3.5rem;
  }

  .valores__layout {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: 960px;
    margin-left: auto;
    margin-right: auto;
  }

  .valores__fila {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .valores__fila {
      display: grid;
      grid-template-columns: 1fr 180px 180px 1fr;
      gap: 1.75rem;
      align-items: center;
    }
  }

  .valores__texto-lateral {
    font-size: 1.1rem;
    line-height: 1.45;
    color: #123B56;
    margin: 0;
    text-align: center;
  }

  @media (min-width: 900px) {
    .valores__texto-lateral--izquierda {
      text-align: right;
    }

    .valores__texto-lateral--derecha {
      text-align: left;
    }
  }

  .valores__tarjeta {
    background-color: var(--color-blanco);
    border-radius: 24px;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 180px;
    height: 180px;
    margin-left: auto;
    margin-right: auto;
    box-shadow: 0 10px 28px rgba(18, 59, 86, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .valores__tarjeta:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(18, 59, 86, 0.1);
  }

  .valores__tarjeta--cercania {
    border: 2.5px solid var(--color-menta);
  }

  .valores__tarjeta--colaboracion {
    border: 2.5px solid var(--color-amarillo);
  }

  .valores__tarjeta--acompanamiento {
    border: 2.5px solid var(--color-coral);
  }

  .valores__tarjeta--memoria {
    border: 2.5px solid var(--color-azul);
  }

  .valores__icono {
    width: 85px;
    height: 85px;
    object-fit: contain;
  }

  .valores__tarjeta-titulo {
    font-family: var(--fuente-titulos);
    font-size: 1.2rem;
    font-weight: 500;
    margin: 0;
  }

  .color-menta {
    color: var(--color-menta);
  }

  .color-amarillo {
    color: #D9A441;
  }

  .color-coral {
    color: var(--color-coral);
  }

  .color-azul {
    color: var(--color-azul);
  }

  @media (max-width: 767px) {
    .hero-nosotros .bloque-texto,
    .bloque-texto {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }
</style>
