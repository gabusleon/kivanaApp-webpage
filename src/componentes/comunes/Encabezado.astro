---
import { enlacesNavegacion } from '@datos/navegacion';
import { Image } from 'astro:assets';
import logoImagen from '@assets/logos/horizontal-tag.svg';

interface Props {
  rutaActual?: string;
}

const { rutaActual = '/' } = Astro.props;

const resolverRuta = (path: string) => {
  if (path.startsWith('http') || path.startsWith('#') || path.startsWith('mailto:')) return path;
  const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
  const cleanPath = path.startsWith('/') ? path.slice(1) : path;
  return `${baseUrl}${cleanPath}`;
};
---

<header class="navbar">
  <div class="contenedor navbar__contenedor">
    <a href={resolverRuta('/')} class="navbar__logo-enlace" aria-label="Ir a la página de inicio de Kivana">
      <Image 
        src={logoImagen} 
        alt="Logo de Kivana - Organiza lo que importa" 
        class="navbar__logo" 
        width={140} 
        height={40}
        loading="eager"
      />
    </a>

    <button 
      type="button" 
      class="navbar__hamburguesa" 
      id="boton-menu-hamburguesa"
      aria-label="Abrir menú de navegación" 
      aria-expanded="false" 
      aria-controls="navegacion-principal"
    >
      <span class="navbar__linea-hamburguesa"></span>
      <span class="navbar__linea-hamburguesa"></span>
      <span class="navbar__linea-hamburguesa"></span>
    </button>

    <nav class="navbar__navegacion" id="navegacion-principal" aria-label="Navegación principal">
      <ul class="navbar__lista">
        {enlacesNavegacion.map((enlace) => {
          const rutaFinal = resolverRuta(enlace.ruta);
          const esActivo = rutaActual === enlace.ruta;
          return (
            <li class="navbar__item">
              <a 
                href={rutaFinal} 
                class={`navbar__enlace ${esActivo ? 'navbar__enlace--activo' : ''}`}
                aria-current={esActivo ? 'page' : undefined}
                aria-label={enlace.descripcionNav || `Navegar a la página de ${enlace.etiqueta}`}
                title={enlace.descripcionNav || `Navegar a la página de ${enlace.etiqueta}`}
              >
                {enlace.etiqueta}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: rgba(var(--color-crema-rgb), 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(var(--color-azul-rgb), 0.08);
    transition: background-color 0.3s ease;
  }

  .navbar--abierto {
    background-color: var(--color-crema);
    backdrop-filter: none;
  }

  .navbar__contenedor {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
  }

  .navbar__logo-enlace {
    display: flex;
    align-items: center;
  }

  .navbar__logo {
    object-fit: contain;
    width: 140px;
    height: auto;
  }

  .navbar__hamburguesa {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 32px;
    height: 22px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1010;
  }

  .navbar__linea-hamburguesa {
    width: 100%;
    height: 3px;
    background-color: var(--color-azul);
    border-radius: 4px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .navbar__navegacion {
    position: fixed;
    top: 80px;
    left: 0;
    width: 100%;
    height: calc(100vh - 80px);
    background-color: var(--color-crema);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
    padding: 2rem;
    z-index: 1005;
    box-shadow: 0 10px 30px rgba(18, 59, 86, 0.1);
  }

  .navbar__navegacion--abierto {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    background-color: var(--color-crema);
  }

  .navbar__lista {
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    padding: 0;
    margin: 0;
    width: 100%;
    max-width: 320px;
  }

  .navbar__enlace {
    font-family: var(--fuente-cuerpo);
    font-size: 1.25rem;
    font-weight: 700;
    color: #123B56;
    transition: color 0.2s ease, border-color 0.2s ease;
    padding: 0.75rem 1.25rem;
    width: 100%;
    text-align: center;
    display: block;
    background-color: transparent;
    border-bottom: 3px solid transparent;
  }

  .navbar__enlace:hover,
  .navbar__enlace:focus-visible {
    color: var(--color-menta);
    background-color: transparent;
    border-bottom: 3px solid var(--color-menta);
  }

  .navbar__enlace--activo {
    color: var(--color-menta);
    background-color: transparent;
    border-bottom: 3px solid var(--color-menta);
  }

  @media (min-width: 1024px) {
    .navbar__hamburguesa {
      display: none;
    }

    .navbar__navegacion {
      position: static;
      top: auto;
      left: auto;
      width: auto;
      height: auto;
      background: transparent;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      padding: 0;
      flex-direction: row;
    }

    .navbar__lista {
      flex-direction: row;
      gap: 1.75rem;
      width: auto;
      max-width: none;
    }

    .navbar__enlace {
      font-size: 1rem;
      font-weight: 600;
      width: auto;
      display: inline-flex;
      align-items: center;
      padding: 0.5rem 0.25rem;
      margin: 0 0.25rem;
      border-radius: 0;
      background-color: transparent;
      border-bottom: 3px solid transparent;
    }

    .navbar__enlace:hover,
    .navbar__enlace:focus-visible {
      color: var(--color-menta);
      background-color: transparent;
      border-bottom: 3px solid var(--color-menta);
    }

    .navbar__enlace--activo {
      color: var(--color-menta);
      background-color: transparent;
      border-bottom: 3px solid var(--color-menta);
      font-weight: 700;
    }
  }

  .navbar__hamburguesa--abierto .navbar__linea-hamburguesa:nth-child(1) {
    transform: translateY(9.5px) rotate(45deg);
  }
  .navbar__hamburguesa--abierto .navbar__linea-hamburguesa:nth-child(2) {
    opacity: 0;
  }
  .navbar__hamburguesa--abierto .navbar__linea-hamburguesa:nth-child(3) {
    transform: translateY(-9.5px) rotate(-45deg);
  }
</style>

<script>
  const navbarHeader = document.querySelector('.navbar');
  const botonMenu = document.getElementById('boton-menu-hamburguesa');
  const navegacion = document.getElementById('navegacion-principal');

  if (botonMenu && navegacion) {
    botonMenu.addEventListener('click', () => {
      const estaAbierto = botonMenu.getAttribute('aria-expanded') === 'true';
      const nuevoEstado = !estaAbierto;

      botonMenu.setAttribute('aria-expanded', String(nuevoEstado));
      botonMenu.setAttribute('aria-label', nuevoEstado ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      botonMenu.classList.toggle('navbar__hamburguesa--abierto', nuevoEstado);
      navegacion.classList.toggle('navbar__navegacion--abierto', nuevoEstado);
      if (navbarHeader) {
        navbarHeader.classList.toggle('navbar--abierto', nuevoEstado);
      }
      document.body.classList.toggle('bloquear-desplazamiento', nuevoEstado);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && botonMenu.getAttribute('aria-expanded') === 'true') {
        botonMenu.click();
      }
    });
  }
</script>
